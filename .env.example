# העתק קובץ זה ל-.env ומלא את הערכים מתוך פרויקט Supabase שלך
# Supabase Dashboard → Project Settings → API
#
# המפתח יכול להיות מהדור החדש (sb_publishable_...) או anon key ישן (eyJ...)

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# מפתח חינמי לקריאת מסמכי PDF באמצעות AI (מתוך https://aistudio.google.com)
